# .env.example
#
# Copy this file to .env and fill in the values. .env is gitignored, so real
# tokens never reach GitHub. Vite reads these at BUILD time, so after you change
# any of them in Netlify you must trigger a redeploy for the live site to see it.
#
#   cp .env.example .env
#
# Then paste your values below. Pull them from Netlify (Site configuration >
# Environment variables) or from each vendor's dashboard.

# Mapbox GL token for the /world/ map. Public client token (it ships in the
# browser bundle), so restrict it by URL in your Mapbox account. From Netlify or
# account.mapbox.com > Tokens.
VITE_MAPBOX_TOKEN=

# Burroship Supabase project (ref dlmqovbtesldsnjksjlu). The URL and the anon key
# are both public browser values. NEVER put the service_role key in here, that one
# is server side only.
VITE_BURROSHIP_SUPABASE_URL=https://dlmqovbtesldsnjksjlu.supabase.co
VITE_BURROSHIP_SUPABASE_ANON_KEY=

# Cesium Ion token. Optional, only used if the map falls back to Cesium terrain.
VITE_CESIUM_ION_TOKEN=
